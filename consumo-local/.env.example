# ── Consumo Histórico local ──
# Copiá este archivo como ".env" (en esta misma carpeta, consumo-local) y
# completá los datos de tu PostgreSQL local. El .env NUNCA se sube al repo.

# Conexión a la base local, por ejemplo:
#   postgresql://postgres:TU_CLAVE@localhost:5432/NOMBRE_DE_LA_BASE
DATABASE_URL=

# SSL: un PostgreSQL instalado en la PC normalmente no lo usa (false).
DB_SSL=false

# Puerto: la página queda en http://localhost:3001
PORT=3001
