# ── Configuración para correr la app en local ──
# Copiá este archivo como ".env" (en la misma carpeta) y completá los valores.
# El .env NUNCA se sube al repositorio (está en .gitignore): tiene contraseñas.
# En Railway no se usa: allá las variables se cargan desde el panel.

# Conexión a PostgreSQL. Para usar la MISMA base que la app de Railway, copiá
# la URL PÚBLICA de la base: en Railway, servicio Postgres > Variables >
# DATABASE_PUBLIC_URL (el host termina en .proxy.rlwy.net). La DATABASE_URL
# interna (postgres.railway.internal) solo funciona dentro de Railway.
DATABASE_URL=

# SSL hacia la base. Dejalo en true para Railway o cualquier base en internet.
# Ponelo en false solo si la base es un PostgreSQL instalado en tu PC.
DB_SSL=true

# Firma las cookies de sesión. Cualquier texto largo y difícil de adivinar.
SESSION_SECRET=

# Puerto local: la app queda en http://localhost:3000
PORT=3000

# Imágenes del Catálogo (Cloudflare R2). Opcional: sin esto, la pestaña
# Catálogo y las miniaturas avisan que falta configurarlo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=imagenes-insumos

# Usuario inicial: solo se usa si la tabla de usuarios está vacía (base nueva).
# Con la base de Railway no hace falta: se entra con los usuarios de siempre.
ADMIN_USER=
ADMIN_PASS=
